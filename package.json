{
  "name": "knowforge-root",
  "version": "1.0.0",
  "description": "KnowForge AI Root Workspace",
  "scripts": {
    "install:backend": "npm install --prefix backend --legacy-peer-deps",
    "install:frontend": "npm install --prefix frontend --legacy-peer-deps",
    "install:all": "npm install concurrently --save-dev && npm run install:backend && npm run install:frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
