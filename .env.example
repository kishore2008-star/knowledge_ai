# ==========================================
# KnowForge AI: Core Configuration Template
# ==========================================

# Port details for Express container
PORT=5000

# Base URL to Supabase PostgreSQL database instance
# Note: Ensure pgvector is enabled before running migrations
DATABASE_URL="postgresql://postgres:your-supabase-db-password@db.supabase.co:5432/postgres?schema=public"

# Secret key for JWT generation
JWT_SECRET="generate-a-secure-random-token-key-for-prod"

# CORS configuration
CORS_ORIGIN="http://localhost:3000"

# OpenAI configuration for Embeddings and Structured RAG responses
# Leave blank to trigger mock fallbacks for local sandboxes
OPENAI_API_KEY=""

# Logging details level: error, warn, info, debug
LOG_LEVEL="info"
